{
  "name": "nicopip",
  "version": "1.9.0",
  "description": "【非公式】ニコニコ動画・ニコニコ生放送をPinPで再生します",
  "license": "MIT",
  "author": "ru_shalm <ru_shalm@hazimu.com>",
  "type": "module",
  "scripts": {
    "build": "run-s build:*",
    "build:vite": "cross-env NODE_ENV=production vite build",
    "dev": "vite",
    "lint": "run-s lint:*",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "lint:tsc": "tsc",
    "format": "run-s format:*",
    "format:oxfmt": "oxfmt --write .",
    "format:oxlint": "oxlint --fix .",
    "zip": "run-s format build zip:*",
    "zip:zipping": "deployment-zip -c .deployment-zip.ts ./dist"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@rutan/deployment-zip": "^0.7.1",
    "@types/chrome": "^0.2.6",
    "@types/dom-navigation": "^1.0.7",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "packageManager": "pnpm@11.22.0"
}
